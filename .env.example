# Shared app configuration
NEXT_PUBLIC_APP_NAME=TalkVibe
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# Mobile / notifications
EXPO_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase admin instructions:
# 1. Open the Pocketbase folder in this project.
# 2. Run: .\pocketbase.exe serve
# 3. Visit: http://127.0.0.1:8090/_/
